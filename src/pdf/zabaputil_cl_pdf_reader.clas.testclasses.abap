CLASS ltcl_reader DEFINITION FINAL
  FOR TESTING RISK LEVEL HARMLESS DURATION SHORT.

  PRIVATE SECTION.

    " One page of A5 with a text in Helvetica and a blue bar, written by
    " zabaputil_cl_pdf: as it is (a cross-reference table), saved again
    " by qpdf with object streams and a cross-reference stream, updated
    " incrementally by pypdf, and encrypted by qpdf

    METHODS classic_table           FOR TESTING.
    METHODS object_streams          FOR TESTING.
    METHODS incremental_update      FOR TESTING.
    METHODS refused                 FOR TESTING.
    METHODS place_and_background    FOR TESTING.
    METHODS dictionary_values       FOR TESTING.
    METHODS form_letterhead         FOR TESTING.

    METHODS file_classic
      RETURNING
        VALUE(result) TYPE xstring.
    METHODS file_objstm
      RETURNING
        VALUE(result) TYPE xstring.
    METHODS file_incremental
      RETURNING
        VALUE(result) TYPE xstring.
    METHODS file_encrypted
      RETURNING
        VALUE(result) TYPE xstring.

    "! The file of a document with the page imported, not deflated, in hex
    METHODS imported
      IMPORTING
        content       TYPE xstring
      RETURNING
        VALUE(result) TYPE string.

    "! What every import of the page brings along
    METHODS assert_page
      IMPORTING
        hex TYPE string.

ENDCLASS.

