  METHOD imported.
    DATA(lo_pdf) = zabaputil_cl_pdf=>create( compress = abap_false ).
    lo_pdf->add_page( )->background( lo_pdf->import_page( content ) ).
    result = lo_pdf->render( ).
  ENDMETHOD.

  METHOD assert_page.
    " a form in the size of A5, its resources with the font copied
    cl_abap_unit_assert=>assert_true( xsdbool( hex CS zabaputil_cl_pdf_writer=>hex(
        `/Type /XObject /Subtype /Form /BBox [0 0 419.53 595.28] /Resources ` ) ) ).
    cl_abap_unit_assert=>assert_true( xsdbool( hex CS zabaputil_cl_pdf_writer=>hex( `/BaseFont /Helvetica` ) ) ).
    " the content of the page: the text and the bar
    cl_abap_unit_assert=>assert_true( xsdbool( hex CS zabaputil_cl_pdf_writer=>hex( `<4C657474657268656164> Tj` ) ) ).
    cl_abap_unit_assert=>assert_true( xsdbool( hex CS zabaputil_cl_pdf_writer=>hex( `re f` ) ) ).
    " in the resources of the pages as P1
    cl_abap_unit_assert=>assert_true( xsdbool( hex CS zabaputil_cl_pdf_writer=>hex( ` /P1 ` ) ) ).
  ENDMETHOD.

  METHOD classic_table.
    DATA(lo_page) = NEW zabaputil_cl_pdf_reader( file_classic( ) ).
    cl_abap_unit_assert=>assert_equals( exp = 1 act = lo_page->page_count( ) ).
    cl_abap_unit_assert=>assert_equals( exp = `419.53` act = zabaputil_cl_pdf_writer=>num( lo_page->width( ) ) ).
    cl_abap_unit_assert=>assert_equals( exp = `595.28` act = zabaputil_cl_pdf_writer=>num( lo_page->height( ) ) ).
    cl_abap_unit_assert=>assert_equals( exp = `P1` act = lo_page->resource( ) ).
    assert_page( imported( file_classic( ) ) ).
  ENDMETHOD.

  METHOD object_streams.
    " the font is in an object stream, found through a cross-reference stream
    assert_page( imported( file_objstm( ) ) ).
  ENDMETHOD.

  METHOD incremental_update.
    " a second section that points to the first with /Prev
    assert_page( imported( file_incremental( ) ) ).
  ENDMETHOD.

  METHOD refused.
    DATA lo_reader TYPE REF TO zabaputil_cl_pdf_reader.
    TRY.
        lo_reader = NEW #( file_encrypted( ) ).
        cl_abap_unit_assert=>fail( ).
      CATCH zabaputil_cx_util_error INTO DATA(lx).
        cl_abap_unit_assert=>assert_true( xsdbool( lx->get_text( ) CS `encrypted` ) ).
    ENDTRY.
    TRY.
        lo_reader = NEW #( zabaputil_cl_util_context=>conv_get_xstring_by_string( `no PDF at all, not even close` ) ).
        cl_abap_unit_assert=>fail( ).
      CATCH zabaputil_cx_util_error ##NO_HANDLER.
    ENDTRY.
    TRY.
        lo_reader = NEW #( content = file_classic( )
                           page    = 2 ).
        cl_abap_unit_assert=>fail( ).
      CATCH zabaputil_cx_util_error INTO lx.
        cl_abap_unit_assert=>assert_true( xsdbool( lx->get_text( ) CS `has 1` ) ).
    ENDTRY.
  ENDMETHOD.

  METHOD place_and_background.
    DATA(lo_pdf) = zabaputil_cl_pdf=>create( ).
    DATA(lo_import) = lo_pdf->import_page( file_classic( ) ).
    DATA(lo_page) = lo_pdf->add_page( ).
    lo_page->rect( x = 1
                   y = 1
                   w = 1
                   h = 1 ).
    " the background under what was drawn before
    lo_page->background( lo_import ).
    " half the size, 100 points from the left and from the top
    lo_page->place( page = lo_import
                    x    = 100
                    y    = 100
                    w    = `209.765` ).
    cl_abap_unit_assert=>assert_equals(
        exp = |q 1 0 0 1 0 246.61 cm /P1 Do Q\n1 839.89 1 1 re S\nq 0.5 0 0 0.5 100 444.25 cm /P1 Do Q|
        act = lo_page->content( ) ).
  ENDMETHOD.

  METHOD dictionary_values.
    DATA(lv_dict) = `<< /Type /Page /MediaBox [0 0 10 20] /Resources << /Font << /F1 5 0 R >> >> /Contents 7 0 R /S (a /Type b) >>`.
    cl_abap_unit_assert=>assert_equals( exp = `/Page`
                                        act = zabaputil_cl_pdf_reader=>dict_value( dict = lv_dict key = `Type` ) ).
    cl_abap_unit_assert=>assert_equals( exp = `[0 0 10 20]`
                                        act = zabaputil_cl_pdf_reader=>dict_value( dict = lv_dict key = `MediaBox` ) ).
    cl_abap_unit_assert=>assert_equals( exp = `<< /Font << /F1 5 0 R >> >>`
                                        act = zabaputil_cl_pdf_reader=>dict_value( dict = lv_dict key = `Resources` ) ).
    cl_abap_unit_assert=>assert_equals( exp = `7 0 R`
                                        act = zabaputil_cl_pdf_reader=>dict_value( dict = lv_dict key = `Contents` ) ).
    " a key of an inner dictionary, a name in a string: not found
    cl_abap_unit_assert=>assert_initial( zabaputil_cl_pdf_reader=>dict_value( dict = lv_dict key = `F1` ) ).
    cl_abap_unit_assert=>assert_equals( exp = `(a /Type b)`
                                        act = zabaputil_cl_pdf_reader=>dict_value( dict = lv_dict key = `S` ) ).
  ENDMETHOD.

  METHOD form_letterhead.
    " under every page, the first page one of its own; in the file once each
    DATA(ls_form) = zabaputil_cl_pdf_form=>new_form( ).
    ls_form-background = file_classic( ).
    ls_form-background_first = file_objstm( ).
    ls_form-t_element = VALUE #( ( type = zabaputil_cl_pdf_form=>cs_type-text text = `one` )
                                 ( type = zabaputil_cl_pdf_form=>cs_type-page_break )
                                 ( type = zabaputil_cl_pdf_form=>cs_type-text text = `two` )
                                 ( type = zabaputil_cl_pdf_form=>cs_type-page_break ) ).
    DATA(lo_pdf) = zabaputil_cl_pdf_form=>build( ls_form ).
    cl_abap_unit_assert=>assert_equals( exp = 3 act = lo_pdf->page_count( ) ).
    cl_abap_unit_assert=>assert_true( xsdbool( lo_pdf->page( 1 )->content( ) CP `q * cm /P2 Do Q*` ) ).
    cl_abap_unit_assert=>assert_true( xsdbool( lo_pdf->page( 2 )->content( ) CP `q * cm /P1 Do Q*` ) ).
    cl_abap_unit_assert=>assert_true( xsdbool( lo_pdf->page( 3 )->content( ) CP `q * cm /P1 Do Q*` ) ).
  ENDMETHOD.

ENDCLASS.
