{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {
    // what the consumers' lints ask of a vendored class - on here, so that
    // a method leaves this catalog in a form every consumer can take over
    // unchanged (popups and table-content-loader run both as errors)
    "omit_parameter_name": {
      "exclude": ["/src/00/"]
    },
    "prefix_is_current_class": {
      "exclude": ["/src/00/"]
    },
    // statements with a successor that this repository no longer uses -
    // listed so they do not come back (abaplint 2.120.116+). src/00/ is
    // excluded: the ajson (00/01) and S-RTTI (00/02) mirrors are synced
    // from upstream unchanged and still use READ TABLE, APPEND, CREATE
    // OBJECT and the other classic statements. Not listed: CreateObject
    // (CREATE OBJECT ... TYPE (name) has no NEW form in v750 - the ZIP
    // helpers and their tests) and MoveCorresponding (the two targets
    // that are generic field symbols, where CORRESPONDING #( ) has no type)
    "forbidden_statement": {
      "exclude": ["/src/00/"],
      "statements": [
        "Describe",
        "Refresh",
        "Ranges",
        "SelectLoop",
        "Collect",
        "Overlay",
        "Leave",
        "TypePools",
        "Perform",
        "Form",
        "Write",
        "ReadTable",
        "Append",
        "GetReference",
        "Check",
        "Replace",
        "Concatenate",
        "Condense",
        "Translate",
        "Find",
        "Shift"
      ]
    },
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true,
    // a failed ASSIGN in a loop keeps the previous binding, so IS ASSIGNED after
    // it answers for the wrong row - UNASSIGN in front (abaplint 2.120.76+)
    "is_assigned_in_loop": true
  }
}
