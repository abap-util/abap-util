{
  "name": "abap-util",
  "version": "1.0.0",
  "description": "Utility functions for ABAP Cloud and Standard ABAP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap-util/abap-util.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap-util/abap-util/issues"
  },
  "homepage": "https://github.com/abap-util/abap-util#readme",
  "dependencies": {
    "@abaplint/cli": "^2.120.92",
    "@abaplint/database-sqlite": "^2.14.12",
    "@abaplint/runtime": "^2.14.15",
    "@abaplint/transpiler-cli": "^2.14.15",
    "@types/node": "^26.6.6",
    "buffer": "^6.0.3",
    "express": "^5.3.0",
    "html-webpack-plugin": "^5.6.8",
    "path-browserify": "^1.0.1",
    "web-encoding": "^1.1.5"
  },
  "scripts": {
    "clone": "git clone https://github.com/abap2UI5/abap2UI5.git input/abap2UI5",
    "rename": "abaplint ./.github/abaplint/rename.jsonc --rename && bash .github/scripts/mirror_copy.sh",
    "cleanup": "rm -rf input && rm -rf .github/abaplint/output",
    "mirror": "npm run clone && npm run rename",
    "syfixes": "find . -type f -name '*.abap' -exec sed -i -e 's/ RAISE EXCEPTION TYPE cx_sy_itab_line_not_found/ ASSERT 1 = 0/g' {} + ",
    "downport": "abaplint --fix .github/abaplint/abap_702.jsonc && npm run syfixes",
    "auto_transpile": "rm -rf node/output && cp -r src node/downport && abap_transpile ./node/setup/abap_transpile.json",
    "unit": "echo RUNNING && node node/output/index.mjs",
    "rename_test": "abaplint .github/abaplint/rename_test.jsonc --rename",
    "lint": "abaplint ./abaplint.jsonc",
    "lint:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "check": "npm run lint && npm run lint:cloud && npm run rename_test",
    "test": "npm run check"
  }
}
